<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Métodos de Pago</title>
  <link rel="stylesheet" href="../CSS/styles.css" />
</head>
<body>

  <header class="header">
    <div class="logo">
      <a href="main.html" style="text-decoration: none;">
        <span class="logo-mark">VAPOR</span>
      </a>
    </div>
    <nav class="nav">
      <a href="perfil.html" class="btn">Perfil</a>
      <a href="productos.html" class="btn">Catálogo</a>
    </nav>
  </header>

  <main class="main">
    <section class="card">
      <h1 class="card-title">Métodos de Pago</h1>
      <p class="card-subtitle">Selecciona tu método de pago preferido</p>

      <div class="payment-methods">
        <div class="payment-option">
          <h3>Tarjeta de Crédito</h3>
          <form id="credit-card-form">
            <div class="form-group">
              <label for="card-number">Número de Tarjeta</label>
              <input type="text" id="card-number" placeholder="1234 5678 9012 3456" maxlength="19" required />
            </div>
            <div class="form-group">
              <label for="card-name">Nombre en la Tarjeta</label>
              <input type="text" id="card-name" placeholder="Juan Pérez" required />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="expiry">Vencimiento</label>
                <input type="text" id="expiry" placeholder="MM/AA" maxlength="5" required />
              </div>
              <div class="form-group">
                <label for="cvv">CVV</label>
                <input type="text" id="cvv" placeholder="123" maxlength="4" required />
              </div>
            </div>
            <button type="submit" class="btn btn-primary">Confirmar Tarjeta</button>
          </form>
        </div>

        <div class="payment-option">
          <h3>PayPal</h3>
          <p>Paga de forma segura con tu cuenta de PayPal</p>
          <div class="form-group">
            <label for="paypal-email">Correo de PayPal</label>
            <input type="email" id="paypal-email" placeholder="tu@email.com" required />
          </div>
          <button class="btn btn-primary" onclick="processPayPal()">Pagar con PayPal</button>
        </div>


      </div>
      <div class="order-summary">
        <h2>Resumen del Pedido</h2>
        <div id="order-items">
        </div>
        <div class="summary-total">
          <p><strong>Subtotal:</strong> <span id="subtotal">$0.00</span></p>
          <p><strong>Impuestos:</strong> <span id="taxes">$0.00</span></p>
          <p><strong>Total:</strong> <span id="total" class="total-amount">$0.00</span></p>
        </div>
      </div>

    </section>
  </main>

  <footer class="footer">
    <p class="muted">© 2025 GRAM — Vapor</p>
  </footer>

  <script src="../JS/metodoPago.js"></script>
</body>
</html>
