<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Métodos de Pago</title>
  <link rel="stylesheet" href="../CSS/styles.css" />
</head>
<body>

  <header class="header">
    <div class="logo">
      <a href="main.html" style="text-decoration: none;">
        <span class="logo-mark">VAPOR</span>
      </a>
    </div>
    <nav class="nav">
      <a href="perfil.html" class="btn">Perfil</a>
      <a href="productos.html" class="btn">Catálogo</a>
    </nav>
  </header>

  <main class="main">
    <section class="card payment-card">
      <div class="payment-header">
        <h1 class="card-title">Método de Pago</h1>
        <p class="card-subtitle">Revisa tu pedido y confirma con tu tarjeta.</p>
      </div>

      <div class="payment-layout">
        <div class="payment-panel">
          <div class="payment-option">
            <h3>Tarjeta</h3>
            <p class="payment-hint">Aceptamos crédito y débito.</p>
            <form id="credit-card-form">
              <div class="form-group">
                <label for="card-number">Número de Tarjeta</label>
                <input type="text" id="card-number" placeholder="1234 5678 9012 3456" maxlength="19" required />
              </div>
              <div class="form-group">
                <label for="card-name">Nombre en la Tarjeta</label>
                <input type="text" id="card-name" placeholder="Juan Pérez" required />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="expiry">Vencimiento</label>
                  <input type="text" id="expiry" placeholder="MM/AA" maxlength="5" required />
                </div>
                <div class="form-group">
                  <label for="cvv">CVV</label>
                  <input type="text" id="cvv" placeholder="123" maxlength="4" required />
                </div>
              </div>
              <button type="submit" class="btn btn-primary payment-submit">Pagar</button>
            </form>
          </div>
        </div>

        <div class="order-summary">
          <div class="order-summary__header">
            <h2>Resumen del Pedido</h2>
          </div>
          <div id="order-items">
          </div>
          <div class="summary-total">
            <p><strong>Total:</strong> <span id="total" class="total-amount">$0.00</span></p>
          </div>
        </div>
      </div>

    </section>
  </main>

  <footer class="footer">
    <p class="muted">© 2025 GRAM — Vapor</p>
  </footer>

  <script src="../JS/metodoPago.js"></script>
</body>
</html>
