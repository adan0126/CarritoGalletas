<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Carrito — Vapor</title>
  <link rel="stylesheet" href="../CSS/styles.css" />
</head>
<body>


  <header class="header">
    <div class="logo">
      <a href="main.html" style="text-decoration: none;">
        <span class="logo-mark">VAPOR</span>
      </a>
    </div>
    <a href="perfil.html" class="btn profile-btn">Perfil</a>
  </header>

  <main class="main">
    <section class="card cart-card">
      <h1 class="card-title">Tu carrito de compras</h1>
      <p class="card-subtitle">Revisa los videojuegos añadidos antes de pagar</p>

      <div class="product-list cart-list">
      </div>

      <div class="cart-total">
        <p><strong>Total:</strong> $0.00</p>
      </div>

      <div class="form-footer">
        <button class="btn btn-primary">Finalizar compra</button>
        <a href="productos.html" class="btn">Regresar al catálogo</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <p class="muted">© 2025 GRAM — Vapor</p>
  </footer>
  <script src="../JS/carrito.js"></script>
</body>
</html>
