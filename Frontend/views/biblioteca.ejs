<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Biblioteca — Vapor</title>
    <link rel="stylesheet" href="../CSS/styles.css" />
    <link rel="stylesheet" href="../CSS/biblioteca.css" />
</head>

<body>

    <header class="header">
        <div class="logo">
            <a href="main.html" style="text-decoration: none;">
                <span class="logo-mark">VAPOR</span>
            </a>
        </div>
        <nav class="nav">
            <a href="perfil.html" class="btn">Perfil</a>
            <a href="productos.html" class="btn">Catálogo</a>
        </nav>
    </header>

    <main class="main">
        <section class="card library-card">
            <h1 class="card-title">Biblioteca</h1>
            <p class="card-subtitle">Tus juegos adquiridos</p>

            <div class="filters">
                <select id="sort-by" class="filter-select">
                    <option value="default">Predeterminado</option>
                    <option value="price-desc">Mayor precio</option>
                    <option value="price-asc">Menor precio</option>
                    <option value="name">Orden alfabético</option>
                </select>
            </div>
            <div class="purchase-history">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Imagen</th>
                            <th>Juego</th>
                            <th>Precio</th>
                            <th>Cantidad</th>
                        </tr>
                    </thead>
                    <tbody id="history-tbody">
                        <template id="purchase-template">
                            <tr class="purchase-row">
                                <td class="product-img-cell">
                                    <img src="" alt="" class="product-thumbnail" />
                                </td>
                                <td class="product-name-cell">
                                    <span class="game-name"></span>
                                </td>
                                <td class="purchase-date-cell">
                                    <span class="purchase-date"></span>
                                </td>
                                <td class="price-cell">
                                    <span class="purchase-price"></span>
                                </td>
                                <td class="transaction-cell">
                                    <span class="transaction-id"></span>
                                </td>
                                <td class="actions-cell">
                                    <button class="btn btn-sm btn-download" title="Descargar juego">Descargar</button>
                                    <button class="btn btn-sm btn-info" title="Ver detalles">Detalles</button>
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>

                <div id="empty-message" class="empty-state" style="display: none;">
                    <p class="muted">No tienes compras registradas aún.</p>
                    <a href="productos.html" class="btn btn-primary">Ir al Catálogo</a>
                </div>
            </div>

            <div class="purchase-stats">
                <div class="stat-card">
                    <h3>Total de Compras</h3>
                    <p class="stat-number" id="total-purchases">0</p>
                </div>
                <div class="stat-card">
                    <h3>Dinero Gastado</h3>
                    <p class="stat-amount" id="total-spent">$0.00</p>
                </div>
                <div class="stat-card">
                    <h3>Juegos en Biblioteca</h3>
                    <p class="stat-number" id="total-games">0</p>
                </div>
                <div class="stat-card">
                    <h3>Última Compra</h3>
                    <p class="stat-date" id="last-purchase">—</p>
                </div>
            </div>

        </section>
    </main>

    <footer class="footer">
        <p class="muted">© 2025 GRAM — Vapor</p>
    </footer>

    <script src="../JS/adminNav.js"></script>
    <script src="../JS/biblioteca.js"></script>
</body>

</html>
