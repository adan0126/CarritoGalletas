<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Historial de Compras</title>
  <link rel="stylesheet" href="../CSS/styles.css" />
</head>
<body>

  <header class="header">
    <div class="logo">
      <span class="logo-mark">Vapor</span>
    </div>
    <nav class="nav">
      <a href="perfil.html" class="btn">Perfil</a>
      <a href="productos.html" class="btn">Catálogo</a>
    </nav>
  </header>

  <main class="main">
    <section class="card">
      <h1 class="card-title">Historial de Compras</h1>
      <p class="card-subtitle">Revisa todos tus juegos adquiridos</p>

      <!-- Filtros -->
      <div class="filters">
        <input 
          type="text" 
          id="search-game" 
          placeholder="Buscar juego..." 
          class="search-input"
        />
        <select id="sort-by" class="filter-select">
          <option value="date-desc">Más recientes primero</option>
          <option value="date-asc">Más antiguos primero</option>
          <option value="price-desc">Mayor precio</option>
          <option value="price-asc">Menor precio</option>
          <option value="name">Orden alfabético</option>
        </select>
      </div>

      <!-- Tabla de Compras -->
      <div class="purchase-history">
        <table class="history-table">
          <thead>
            <tr>
              <th>Imagen</th>
              <th>Juego</th>
              <th>Fecha de Compra</th>
              <th>Precio</th>
              <th>ID de Transacción</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="history-tbody">
            <!-- Los registros se cargarán dinámicamente desde Supabase -->
            <template id="purchase-template">
              <tr class="purchase-row">
                <td class="product-img-cell">
                  <img src="" alt="" class="product-thumbnail" />
                </td>
                <td class="product-name-cell">
                  <span class="game-name"></span>
                </td>
                <td class="purchase-date-cell">
                  <span class="purchase-date"></span>
                </td>
                <td class="price-cell">
                  <span class="purchase-price"></span>
                </td>
                <td class="transaction-cell">
                  <span class="transaction-id"></span>
                </td>
                <td class="actions-cell">
                  <button class="btn btn-sm btn-download" title="Descargar juego">Descargar</button>
                  <button class="btn btn-sm btn-info" title="Ver detalles">Detalles</button>
                </td>
              </tr>
            </template>
          </tbody>
        </table>

        <!-- Mensaje cuando no hay compras -->
        <div id="empty-message" class="empty-state" style="display: none;">
          <p class="muted">No tienes compras registradas aún.</p>
          <a href="productos.html" class="btn btn-primary">Ir al Catálogo</a>
        </div>
      </div>

      <!-- Estadísticas -->
      <div class="purchase-stats">
        <div class="stat-card">
          <h3>Total de Compras</h3>
          <p class="stat-number" id="total-purchases">0</p>
        </div>
        <div class="stat-card">
          <h3>Dinero Gastado</h3>
          <p class="stat-amount" id="total-spent">$0.00</p>
        </div>
        <div class="stat-card">
          <h3>Juegos en Biblioteca</h3>
          <p class="stat-number" id="total-games">0</p>
        </div>
        <div class="stat-card">
          <h3>Última Compra</h3>
          <p class="stat-date" id="last-purchase">—</p>
        </div>
      </div>

      <!-- Botones de Acción -->
      <div class="action-buttons">
        <button class="btn btn-secondary" onclick="exportPurchaseHistory()">
          Exportar Historial
        </button>
        <button class="btn btn-secondary" onclick="printPurchaseHistory()">
          Imprimir
        </button>
      </div>

    </section>
  </main>

  <footer class="footer">
    <p class="muted">© 2025 GRAM — Vapor</p>
  </footer>

  <script src="../JS/historialCompras.js"></script>
</body>
</html>
